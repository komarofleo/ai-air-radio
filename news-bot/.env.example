# Copy to .env on the VDS and chmod 600. Never commit real values.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_ID=329621295

# OpenAI (default LLM for filter + summary + EN→RU)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional later: Gemini Flash hook
GEMINI_API_KEY=

DATABASE_PATH=/var/lib/aiair-news-bot/bot.db
SOURCES_PATH=/opt/aiair-news-bot/sources.yaml

BATCH_SIZE=2
INTERVAL_MINUTES=360
PUBLISH_ENABLED=true
TRANSLATE_ENABLED=true
COLLECT_INTERVAL_MINUTES=30
LLM_MAX_PER_CYCLE=8

# Comma-separated topic keywords (case-insensitive)
TOPICS="suno,udio,ai music,generative music,ai radio,music generation,text-to-music,ai dj"

# Dry-run: collect/filter/queue but do not send to Telegram
DRY_RUN=false

LOG_LEVEL=INFO
